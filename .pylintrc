# Pylint configuration for Nokia NSP Ansible Collection
#
# All checks are enabled with pylint's default limits. Silence a finding only
# inline, on the affected line, where the code cannot follow the check.

[FORMAT]
# Same limit as flake8
max-line-length=120

[BASIC]
# Good variable names which should always be accepted
good-names=
    i,j,k,
    ex,Run,_,
    x,y,z,
    id,uuid,

[SIMILARITIES]
min-similarity-lines=10
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=yes
